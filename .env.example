# Optional: setting these enables shared, persistent Supabase storage.
# Copy this file to .env.local and use the values from your Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Use a strong value before deployment.
ADMIN_PIN=your-admin-pin
